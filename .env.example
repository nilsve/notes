# OpenAI-compatible endpoint used for answering questions about past incidents.
OPENAI_API_KEY=sk-your-key
# Point this at your own OpenAI-compatible server (include the /v1 suffix).
OPENAI_API_BASE=http://localhost:1234/v1
OPENAI_MODEL=gpt-4o-mini

# Storage
DYNAMO_TABLE=records
WEAVIATE_CLASS=Record

# Filled in by docker compose for the container runtime
WEAVIATE_HOSTNAME=localhost
WEAVIATE_PORT=8080

# Where the compiled frontend lives (relative to the server binary)
FRONTEND_LOCATION=static
