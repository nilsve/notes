# Copy to .env and fill in. docker-compose overrides the container-to-container
# URLs (postgres/weaviate) in its own `environment:` block.

# --- AI: any OpenAI-compatible server ---
OPENAI_API_BASE=https://ssh.nilles.dev/halogen/v1
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=halogen-qwen3.8-flash-next
# How hard the model should think: none | minimal | low | medium | high | xhigh.
# `none` is sent explicitly; omitting it leaves thinking up to the server.
# Levels above `none` are advisory on some deployments.
OPENAI_REASONING_EFFORT=medium

# --- Storage ---
# Inside docker compose these are overridden with container-to-container addresses.
# Neither Postgres nor Weaviate publishes a host port, so the localhost URLs below
# only work if you join the compose network, e.g.:
#   docker run --rm -it --network notes_internal \
#     -e DATABASE_URL=postgres://incidents:incidents@postgres:5432/incidents \
#     -e WEAVIATE_HOSTNAME=weaviate -e WEAVIATE_PORT=8080 ...
DATABASE_URL=postgres://incidents:incidents@localhost:5432/incidents
WEAVIATE_HOSTNAME=localhost
WEAVIATE_PORT=8081

# --- Server ---
# Single public port: API under /api, SPA everywhere else.
PORT=1337

# --- Embedding model cache ---
# The all-MiniLM-L12-V2 weights are downloaded on first use. Inside docker compose
# this points at the `rustbert_cache` named volume so the download survives
# restarts/rebuilds. When running the server directly on a machine you can leave it
# unset (defaults to $XDG_CACHE_HOME/.rustbert) or point it somewhere persistent.
# RUSTBERT_CACHE=/var/cache/rustbert

# --- Frontend ---
FRONTEND_LOCATION=static
